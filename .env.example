# Application Environment Configuration
APP_NAME="Intelligent Business Process Monitoring & Auto-Alert System"
APP_ENV=development
DEBUG=True
SEED_DEMO_DATA=True
DATABASE_URL=sqlite:///business_monitor.db
TIMEZONE=UTC
API_TOKEN_SECRET=
API_TOKEN_TTL_MINUTES=480
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Monitoring Configuration
DEFAULT_MONITORING_INTERVAL_MINUTES=60
TRANSACTION_FAILURE_THRESHOLD_PCT=5.0
COST_ANOMALY_ZSCORE_THRESHOLD=2.5
COST_BUDGET_OVERRUN_THRESHOLD_PCT=20.0
DEPARTMENT_SLA_MIN_COMPLETION_RATE=80.0
INCIDENT_RESOLUTION_SLA_HOURS=48

# Email Notification Configuration (Leave blank for Simulated Demo Mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@businessmonitor.local
ALERT_RECIPIENT_EMAIL=ops-manager@businessmonitor.local
ALERT_MIN_SEVERITY=High
ENABLE_EMAIL_ALERTS=False
